# =============================================================================
# HOSTINGER - LiteSpeed/Apache Performance Configuration
# Site: https://febreamarela.blog/
# =============================================================================

# Ativar RewriteEngine
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Forçar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Remover www (ou adicionar, escolha um)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
  
  # SPA Fallback - redirecionar para index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# =============================================================================
# CACHE CONTROL - Assets com Hash (Cache Agressivo)
# =============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Assets com hash (JS, CSS, imagens otimizadas) - 1 ano
  <FilesMatch "\.(js|css|webp|avif|png|jpg|jpeg|gif|svg|woff2|woff)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # HTML - cache curto (sempre verificar atualização)
  <FilesMatch "\.(html|htm)$">
    ExpiresDefault "access plus 1 hour"
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  
  # JSON e outros dados - cache médio
  <FilesMatch "\.(json|txt|xml)$">
    ExpiresDefault "access plus 1 day"
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# =============================================================================
# COMPRESSÃO - Brotli e Gzip
# =============================================================================
<IfModule mod_brotli.c>
  # Brotli (prioridade máxima)
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml application/xhtml+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2
  BrotliCompressionLevel 6
</IfModule>

<IfModule mod_deflate.c>
  # Gzip (fallback para navegadores antigos)
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# =============================================================================
# HEADERS DE SEGURANÇA E PERFORMANCE
# =============================================================================
<IfModule mod_headers.c>
  # Remover headers desnecessários
  Header unset X-Powered-By
  Header unset Server
  
  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Vary header para cache correto com compressão
  Header append Vary "Accept-Encoding"
</IfModule>

# =============================================================================
# OTIMIZAÇÃO DE IMAGENS - WebP/AVIF com fallback
# =============================================================================
<IfModule mod_rewrite.c>
  # Servir WebP se o navegador suportar
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_URI} (?i)(.*)(\.jpe?g|\.png)$
  RewriteCond %{DOCUMENT_ROOT}%1.webp -f
  RewriteRule (?i)(.*)(\.jpe?g|\.png)$ %1.webp [L,T=image/webp,R]
  
  # Servir AVIF se o navegador suportar (prioridade sobre WebP)
  RewriteCond %{HTTP_ACCEPT} image/avif
  RewriteCond %{REQUEST_URI} (?i)(.*)(\.jpe?g|\.png)$
  RewriteCond %{DOCUMENT_ROOT}%1.avif -f
  RewriteRule (?i)(.*)(\.jpe?g|\.png)$ %1.avif [L,T=image/avif,R]
</IfModule>

# =============================================================================
# PRELOAD DE FONTES E RECURSOS CRÍTICOS
# =============================================================================
<IfModule mod_headers.c>
  # Link headers para preload de recursos críticos
  <FilesMatch "\.html$">
    Header set Link "<https://fonts.googleapis.com>; rel=preconnect"
    Header set Link "<https://fonts.gstatic.com>; rel=preconnect; crossorigin"
  </FilesMatch>
</IfModule>

# =============================================================================
# BLOQUEIO DE ACESSO A ARQUIVOS SENSÍVEIS
# =============================================================================
<FilesMatch "\.(env|log|md|json|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Bloquear acesso a node_modules e src
<IfModule mod_rewrite.c>
  RewriteRule ^node_modules/ - [F,L]
  RewriteRule ^src/ - [F,L]
  RewriteRule ^vite\.config\. - [F,L]
</IfModule>

# =============================================================================
# PERFORMANCE - Desativar ETags (usar Cache-Control)
# =============================================================================
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# =============================================================================
# KEEP-ALIVE - Manter conexões abertas
# =============================================================================
<IfModule mod_headers.c>
  Header set Connection "keep-alive"
</IfModule>
